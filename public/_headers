# Cloudflare Pages headers.
#
# The JSON artifacts are meant to be fetched by tooling from other origins, so
# they carry permissive CORS. Everything else is locked down — a standards site
# has no reason to be embeddable or to leak referrers.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

/*.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
